// ### functions ###
void Set_MinMax_Unit(int Grid) {  // 2012-04-12
  switch(Grid) {
    case GRID_UNIT_MIC  : {  // Micron
                            minx = -1990000;
                            maxx =  1990000;
                            miny = -1990000;
                            maxy =  1990000;
                            break;
                          }
    case GRID_UNIT_MM   : {  // Millimeter
                            minx = -1990;
                            maxx =  1990;
                            miny = -1990;
                            maxy =  1990;
                            break;
                          }
    case GRID_UNIT_MIL  : {  // Mil
                            minx = -78340;
                            maxx =  78340;
                            miny = -78340;
                            maxy =  78340;
                            break;
                          }
    case GRID_UNIT_INCH : {  // Inch
                            minx = -78.34;
                            maxx =  78.34;
                            miny = -78.34;
                            maxy =  78.34;
                            break;
                          }
  }
  return;
}


real u2u(int val) {
  switch (gridunit) {
    case GRID_UNIT_MIC  : return u2mic(val);
    case GRID_UNIT_MM   : return u2mm(val);
    case GRID_UNIT_MIL  : return u2mil(val);
    case GRID_UNIT_INCH : return u2inch(val);
  }
}


void info(void) {
  dlgDialog("cmd-draw HELP") {
    dlgHBoxLayout {
      dlgLabel(usage);
      dlgVBoxLayout {
        dlgLabel("<u>Examples</u>:");
        dlgLabel(Help);
        dlgStretch(1);
        dlgHBoxLayout {
          dlgStretch(1);
          dlgPushButton("+Ok") dlgAccept();
          dlgStretch(1);
        }
      }
    }
  };
  return;
}


// ### layer pulldown ###
void addLayerEntry(int number, string name, int color) {
  string e;
  LayerCount++;
  sprintf(e, "%3d  %s", number, name);
  LayerText[LayerCount]   = e;
  LayerNumber[LayerCount] = number;
  LayerRGB[LayerCount]    = palette(color);   // color as currently shown in the editor
  return;
}

// fill the pulldown with the layers of the current editor
void loadLayers(void) {
  LayerText[0]   = "(none - keep current layer)";
  LayerNumber[0] = 0;
  LayerRGB[0]    = 0;
  LayerCount     = 0;
  // inner copper layers 2..15 are listed only if the board really uses them
  if (board) board(B) B.layers(Ly) {
    if (Ly.name && (Ly.number < 2 || Ly.number > 15 || Ly.used)) addLayerEntry(Ly.number, Ly.name, Ly.color);
  }
  if (schematic) schematic(S) S.layers(Ly) {
    if (Ly.name) addLayerEntry(Ly.number, Ly.name, Ly.color);
  }
  if (library) library(LB) LB.layers(Ly) {
    if (Ly.name) addLayerEntry(Ly.number, Ly.name, Ly.color);
  }
  return;
}

// pulldown selection -> layer string used by the script
void syncLayer(void) {
  if (LayerSel > 0) sprintf(layer, "%d", LayerNumber[LayerSel]);
  else              layer = "";
  return;
}

// layer 20 (Dimension) accepts only wires, never polygons
int isDimensionLayer(string l) {
  string u = strupr(l);
  return (u == "20" || u == "DIMENSION");
}


// the length field (x2) is a radius for Wire/Polygon/Move, but the distance from the
// center to the placed element for Pad/Smd/Via/Hole (= radius of the placement circle)
int usesDistance(void) {
  return (DrawType == DrawPAD || DrawType == DrawSMD || DrawType == DrawHOLE || DrawType == DrawGROUP);
}

string lengthName(void) {
  if (usesDistance()) return "Distance";
  return "Radius";
}


// *** analysis User Error ***
int error(void) {
  int err = 0;
  if (DrawType == DrawGROUP) {
    // FIX: removed duplicated test (!AngleStep twice) and an unreachable branch
    if (!AngleStep || !EndAngle) { Help_Err = "Angle step or Angle end = 0"; return -1; }
    if (!AngleStepTyp) {
      Help_Err = "Select Angle step type :\n° degree step\ncalc. steps.";
      return -1;
    }
    return 0;
  }
  // width is only used (and shown) for Wire and Polygon
  if ((DrawType == DrawWIRE || DrawType == DrawPOLYGON) && strtod(width) >= x2) {
    Help_Err = "Width > " + lengthName();  err = -1;
  }
  if (!x2) {
    Help_Err = lengthName() + " = 0";
    if (usesDistance()) Help_Err += " (distance from the center X/Y to the placed element)";
    err = -1;
  }
    if (DrawType == DrawSMD) {
    if (layer == "1" || layer == "16") ;
    else { err = -1; Help_Err = "Layer for SMD ?"; }
  }
  if (DrawType == DrawMOVE) {
    if (!SigName) { Help_Err = "1.st Element name ?"; err = -1; }
  }
  if (DrawType == DrawPOLYGON) {
    // a ULP cannot read the active editor layer, so the layer must be given explicitly
    if (!layer) { err = -1; Help_Err = "Select the Layer for the Polygon (20 Dimension = board outline)"; }
    if ((Placeform == FULL_ELLIPSE || Placeform == ELLIPSE_4) && EllipsFactor == 1.0) {
      err = -1; Help_Err = "Ellipse factor missing: set a value other than 1.0";
    }
  }
  if (DrawType == DrawPOLYGON && Align && Sides <= 0) { err = -1; Help_Err = "Align needs Polygon sides"; }
  if (DrawType == DrawPOLYGON && Sides > 0) {   // number of sides replaces angle step/end
    if (Sides < 3)                { err = -1; Help_Err = "Sides must be at least 3"; }
    if (Placeform == ELLIPSE_4)   { err = -1; Help_Err = "Sides: not usable with 1/4 ellipse"; }
  }
  else if (DrawType == DrawPOLYGON && AngleStep <= 0) {
    err = -1; Help_Err = "Polygon needs an Angle step type (degree or calc.) with a positive Angle step, or Polygon sides";
  }
  else if (AngleStepTyp && AngleStep == 0) {
    err = -1; Help_Err = "Missing parameter: Angle step";
  }
  return err;
}



